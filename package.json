{
  "name": "@chriscalo/sh-cmd-tag",
  "version": "1.0.0",
  "description": "Template tag functions for shell command execution with streaming output, safe interpolation, and flexible I/O control",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "test": "node --test --no-warnings *.test.js .vitepress/*.test.js scripts/*.test.js",
    "test:verbose": "DEBUG=test npm test",
    "docs:dev": "node scripts/dev.js",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview ."
  },
  "keywords": [
    "shell",
    "command",
    "execution",
    "template",
    "literal",
    "process",
    "spawn",
    "child_process"
  ],
  "author": "chris.calo@gmail.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "volta": {
    "node": "24.5.0"
  },
  "devDependencies": {
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "vitepress": "^2.0.0-alpha.16"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
